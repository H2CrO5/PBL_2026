# Copy this file to .env and fill in values locally. Never commit .env.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Use the same long random value for both Student and Teacher services.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TEACHER_INTEGRATION_TOKEN=
# Optional production databases. Leave blank/unset to use local SQLite.
# STUDENT_DATABASE_URL=postgresql+psycopg://user:password@host:5432/classpilot_student
# TEACHER_DATABASE_URL=postgresql+psycopg://user:password@host:5432/classpilot_teacher
STUDENT_API_BASE_URL=http://localhost:8000
STUDENT_API_TIMEOUT=5
STUDENT_RAG_TIMEOUT=300
MAX_MATERIAL_UPLOAD_BYTES=20971520
MATERIALS_S3_BUCKET=
MATERIALS_S3_PREFIX=classpilot/materials
STUDENT_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
TEACHER_CORS_ORIGINS=http://localhost:8601,http://127.0.0.1:8601

# Enabled for the Bedrock-backed demo. Set to 0 for an offline-only Teacher UI.
TEACHER_USE_LLM=1
TEACHER_DEMO_MODE=0
